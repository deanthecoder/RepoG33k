<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="RepoG33k.WorkspaceWindow" Title="RepoG33k" Width="1480" Height="1020" MinWidth="1080" MinHeight="740">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="#171F2A" BorderBrush="#2B3949" BorderThickness="0,0,0,1" Padding="12,9">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <ComboBox Name="RepositoryPicker" Width="250" MaxDropDownHeight="360" PlaceholderText="Choose a repository" />
          <Button Name="RepositoryRootButton" AutomationProperties.Name="Choose repo folder" ToolTip.Tip="Choose the parent folder containing your repositories"><StackPanel Orientation="Horizontal" Spacing="6"><icons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" /><TextBlock Text="Repo folder…" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
        <SelectableTextBlock Name="RepositoryPathLabel" Background="Transparent" Grid.Row="1" Grid.ColumnSpan="3" Text="Choose a repo folder to find your repositories." Foreground="#8B9DAF" FontSize="11" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Spacing="2"><TextBlock Name="BranchLabel" Text="No repository selected" Foreground="#D9E3EE" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Name="UpstreamLabel" Foreground="#8B9DAF" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Name="FetchButton" Content="↻  Fetch" /><Button Name="PullButton" Content="↓  Pull" ToolTip.Tip="Fast-forward only; use Rebase for diverged branches" /><Button Name="PushButton" Content="↑  Push" />
          <Button Name="AccountButton" Content="✦  Sign in with ChatGPT" BorderBrush="#2B3949" BorderThickness="1" Margin="9,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="245,5,*">
      <Border Background="#141C26" BorderBrush="#2B3949" BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8,9" Spacing="4">
            <Expander Name="WorkingSection" Header="WORKING COPY" IsExpanded="True"><StackPanel><Button Name="AllChangesButton" Classes="nav selected" Content="▧  All changes" /><Button Name="UnstagedButton" Classes="nav" Content="◌  Unstaged" /><Button Name="StagedButton" Classes="nav" Content="✓  Staged" /></StackPanel></Expander>
            <Expander Name="BranchSection" Header="LOCAL BRANCHES" IsExpanded="True"><StackPanel><StackPanel Name="LocalBranches" /><Button Name="NewBranchButton" Classes="nav" Content="＋  New branch…" /></StackPanel></Expander>
            <Expander Name="RemoteSection" Header="REMOTES" IsExpanded="True"><StackPanel Name="RemoteBranches" /></Expander>
            <Button Name="PullRequestButton" Classes="nav" Content="⑂  Open Bitbucket PR…" Margin="0,3,0,8" />
            <Expander Name="HistorySection" Header="COMMITS" IsExpanded="False"><StackPanel Name="Commits" /></Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#10161F" />
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" Name="RepositoryArea">
        <Border Background="#171F2A" Padding="17,12" BorderBrush="#2B3949" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Name="ScopeHeading" Text="Your repository, in one view" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"><Button Name="RefreshButton" Content="Refresh" /><Button Name="RebaseButton" Content="Rebase…" /><Button Name="ReviewButton" Classes="primary" Content="Run review" /></StackPanel></Grid>
        </Border>
        <Border Grid.Row="1" Name="OperationBanner" IsVisible="False" Background="#233E3B" Padding="15,8"><Grid ColumnDefinitions="*,Auto"><TextBlock Name="OperationLabel" VerticalAlignment="Center" TextWrapping="Wrap" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Name="ResolveButton" Content="Copy Codex task" /><Button Name="ContinueButton" Content="Continue rebase" /><Button Name="AbortButton" Content="Abort rebase" /></StackPanel></Grid></Border>
        <ContentControl Name="DiffLensHost" Grid.Row="2"><TextBlock Text="Choose a repo folder to get started." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8B9DAF" /></ContentControl>
        <Border Grid.Row="3" Background="#171F2A" BorderBrush="#2B3949" BorderThickness="0,1,0,0" Padding="10,0">
          <Expander Name="CommitPanel" MinHeight="0" Padding="0" Header="Commit staged changes" IsExpanded="True">
          <StackPanel Name="CommitFields" Spacing="7" Margin="6,3,6,8">
            <Grid ColumnDefinitions="Auto,*,Auto"><Button Name="ConventionButton" Content="Home · Feature  ⌄" FontSize="11" Padding="7,4" Margin="0,0,8,0" BorderBrush="#2B3949" BorderThickness="1" /><TextBox Name="SummaryBox" Grid.Column="1" Watermark="Summary" MaxLines="1" AcceptsReturn="False" /><Button Name="DraftButton" Grid.Column="2" Classes="accent" Content="✦  Draft with Codex" FontSize="12" Padding="7,4" Margin="8,0,0,0" /></Grid>
            <TextBox Name="DetailsBox" Watermark="Details (optional) — what changed and why" AcceptsReturn="True" TextWrapping="Wrap" Height="66" />
            <Grid ColumnDefinitions="*,Auto,Auto"><CheckBox Name="AmendCheckBox" Grid.Column="1" Content="Amend last commit" FontSize="11" MinHeight="20" Margin="8,0,14,0" /><Button Name="CommitButton" Grid.Column="2" Classes="primary" Content="Commit" /></Grid>
          </StackPanel>
          </Expander>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#141C26" BorderBrush="#2B3949" BorderThickness="0,1,0,0" Padding="13,6"><Grid ColumnDefinitions="Auto,*,Auto"><TextBlock Text="●  RepoG33k" Foreground="#79DDC4" FontSize="11" /><TextBlock Name="StatusLabel" Grid.Column="1" Margin="18,0" Text="Ready" Classes="muted" TextTrimming="CharacterEllipsis" /><Button Name="CancelButton" Grid.Column="2" Content="Cancel" IsVisible="False" Padding="6,0" FontSize="11" /></Grid></Border>
  </Grid>
</Window>
